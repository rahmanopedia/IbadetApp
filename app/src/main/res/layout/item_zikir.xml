<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#1A2E22"
    app:strokeColor="#40FFD700"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Üst Bölüm: Başlık ve Kategori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Kategori Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A4030"
                app:strokeColor="#50FFD700"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tv_zikir_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tesbih"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:letterSpacing="0.08" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Zikir Adı -->
            <TextView
                android:id="@+id/tv_zikir_translit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sübhanallah"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.02" />

            <!-- Sil Butonu -->
            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/bg_button_gold"
                android:padding="8dp"
                android:visibility="gone"
                android:contentDescription="Sil"
                app:tint="#D32F2F" />

        </LinearLayout>

        <!-- Arapça Metin -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#0D1A15"
            app:strokeColor="#30FFD700"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tv_zikir_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="سُبْحَانَ ٱللَّٰهِ"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="16dp"
                android:textDirection="rtl"
                android:fontFamily="@font/arabic_font"
                android:lineSpacingMultiplier="1.8"
                android:shadowColor="#FFD700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Türkçe Anlam -->
        <TextView
            android:id="@+id/tv_zikir_turkish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allah'ı tespih ederim"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:gravity="center"
            android:layout_marginBottom="14dp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Alt Bölüm: Progress ve Hedef -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Progress Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_progress_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İlerleme"
                        android:textSize="11sp"
                        android:textColor="#66FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_progress_percent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFD700"
                        android:gravity="end" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="4dp"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp"
                    app:indicatorColor="#FFD700"
                    app:trackColor="#20FFD700"
                    app:progress="0"
                    app:max="100" />

            </LinearLayout>

            <!-- Hedef -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A4030"
                app:strokeColor="#50FFD700"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tv_zikir_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="33"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>