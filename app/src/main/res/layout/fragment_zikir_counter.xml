<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tesbih_gradient">

    <!-- Üst: Kompakt Zikir Bilgisi -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_zikir_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1A2E22"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeColor="#40FFD700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- Sol: İsim ve Anlam -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_zikir_translit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tv_zikir_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="#FFD700"
                        android:background="#20FFD700"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_zikir_turkish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#88FFFFFF" />

            </LinearLayout>

            <!-- Sağ: Arapça -->
            <TextView
                android:id="@+id/tv_zikir_arabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="#FFD700"
                android:gravity="center"
                android:textDirection="rtl"
                android:fontFamily="@font/arabic_font"
                android:lineSpacingMultiplier="1.6"
                android:shadowColor="#FFD700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Ana Sayaç Alanı -->
    <FrameLayout
        android:id="@+id/fl_counter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/card_zikir_info"
        app:layout_constraintBottom_toTopOf="@id/fl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            app:trackThickness="10dp"
            app:indicatorColor="#FFD700"
            app:trackColor="#15FFFFFF"
            app:trackCornerRadius="5dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-thin"
                android:text="0"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_target_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#55FFFFFF"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:text="%0" />

        </LinearLayout>

    </FrameLayout>

    <!-- Sayaç Butonu -->
    <FrameLayout
        android:id="@+id/fl_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ll_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.18" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_count"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:text="+"
            android:textSize="58sp"
            android:textColor="#0D2010"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            app:cornerRadius="70dp"
            android:elevation="12dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:paddingBottom="8dp" />

    </FrameLayout>

    <!-- Kontroller -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sıfırla"
            android:textColor="#EE6B6B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="32dp"
            app:strokeColor="#55EE6B6B"
            app:strokeWidth="2dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/btn_vibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:checked="true"
            android:textColor="#66FFFFFF"
            android:textSize="13sp"
            app:thumbTint="#FFD700"
            app:trackTint="#40FFD700" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
