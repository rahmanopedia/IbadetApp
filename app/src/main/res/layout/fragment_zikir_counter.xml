<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tesbih_gradient">

    <!-- ─── ZİKİR BİLGİ KARTI ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_zikir_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#0E1A13"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="#35FFD700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_zikir_translit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F5F5F5"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_zikir_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="#FFD700"
                        android:background="@drawable/bg_category_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_zikir_turkish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#65FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="14dp"
                android:background="#20FFD700" />

            <TextView
                android:id="@+id/tv_zikir_arabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="#FFD700"
                android:gravity="center"
                android:textDirection="rtl"
                android:fontFamily="@font/arabic_font"
                android:lineSpacingMultiplier="1.4"
                android:shadowColor="#90FFD700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ─── SAYAÇ HALKA (220dp) ─── -->
    <FrameLayout
        android:id="@+id/fl_counter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/card_zikir_info"
        app:layout_constraintBottom_toTopOf="@id/fl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.42">

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            app:trackThickness="11dp"
            app:indicatorColor="#FFD700"
            app:trackColor="#18FFFFFF"
            app:trackCornerRadius="6dp" />

        <View
            android:layout_width="162dp"
            android:layout_height="162dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_counter_circle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="68sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-thin"
                android:text="0"
                android:includeFontPadding="false" />

            <View
                android:layout_width="36dp"
                android:layout_height="1dp"
                android:layout_marginBottom="3dp"
                android:background="#22FFD700" />

            <TextView
                android:id="@+id/tv_target_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#50FFFFFF"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#B8920A"
                android:text="%0"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- ─── ALTIN SAYAÇ BUTONU ─── -->
    <FrameLayout
        android:id="@+id/fl_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/fl_counter"
        app:layout_constraintBottom_toTopOf="@id/ll_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dış parlama -->
        <View
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.09" />

        <!-- Orta parlama -->
        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.12" />

        <!-- İnce altın çember -->
        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- Ana buton -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_count"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:text="+"
            android:textSize="54sp"
            android:textColor="#0A1A0E"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            app:cornerRadius="64dp"
            android:elevation="16dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:paddingBottom="6dp" />

    </FrameLayout>

    <!-- ─── ALT KONTROLLER ─── -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingBottom="76dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↺  Sıfırla"
            android:textColor="#E06060"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="36dp"
            app:strokeColor="#60E06060"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/btn_vibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:checked="true"
            android:textColor="#55FFFFFF"
            android:textSize="13sp"
            app:thumbTint="#FFD700"
            app:trackTint="#40FFD700" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
