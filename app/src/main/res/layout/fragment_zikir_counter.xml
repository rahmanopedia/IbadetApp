<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tesbih_gradient">

    <!-- ───────── ÜSTTE BİSMİLLAH ───────── -->
    <TextView
        android:id="@+id/tv_bismillah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
        android:textSize="14sp"
        android:textColor="#55FFD700"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:fontFamily="@font/arabic_font"
        android:textDirection="rtl"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/line_top"
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:background="#35FFD700"
        app:layout_constraintTop_toBottomOf="@id/tv_bismillah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ───────── ZİKİR METİN KARTI ───────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_zikir_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#1C3025"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#35FFD700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/line_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_zikir_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:textDirection="rtl"
                android:fontFamily="@font/arabic_font"
                android:lineSpacingMultiplier="1.7" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="#30FFD700"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_zikir_translit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_zikir_turkish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#77FFFFFF"
                android:gravity="center"
                android:layout_marginTop="3dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ───────── DAİRESEL SAYAÇ ALANI ───────── -->
    <FrameLayout
        android:id="@+id/fl_counter"
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:layout_constraintTop_toBottomOf="@id/card_zikir_info"
        app:layout_constraintBottom_toTopOf="@id/fl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- En dıştaki çok ince ring (dekoratif) -->
        <View
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- Orta ince ring -->
        <View
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- İlerleme ring (gold) -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center"
            app:trackThickness="10dp"
            app:indicatorColor="#FFD700"
            app:trackColor="#18FFFFFF"
            app:trackCornerRadius="5dp" />

        <!-- Merkez içerik -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="84sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-thin"
                android:text="0"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_target_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#60FFFFFF"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAFFD700"
                android:text="%0"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- ───────── SAYAÇ BUTONU ───────── -->
    <FrameLayout
        android:id="@+id/fl_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/ll_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dış glow efekti -->
        <View
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.18"
            android:translationY="6dp" />

        <!-- Orta glow -->
        <View
            android:layout_width="162dp"
            android:layout_height="162dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.15" />

        <!-- Ana buton -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_count"
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:text="+"
            android:textSize="60sp"
            android:textColor="#0D2010"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            app:cornerRadius="76dp"
            android:elevation="14dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:paddingBottom="8dp" />

    </FrameLayout>

    <!-- ───────── ALT KONTROLLER ───────── -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="22dp"
        android:paddingTop="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sıfırla"
            android:textColor="#EE6B6B"
            android:textSize="13sp"
            android:layout_marginEnd="28dp"
            app:strokeColor="#55EE6B6B"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            android:paddingHorizontal="18dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/btn_vibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:checked="true"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
