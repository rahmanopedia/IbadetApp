<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tesbih_gradient">

    <!-- Üst Bismillah -->
    <TextView
        android:id="@+id/tv_bismillah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بِسْمِ ٱللَّٰهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
        android:textSize="16sp"
        android:textColor="#55FFD700"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:fontFamily="@font/arabic_font"
        android:textDirection="rtl"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/line_top"
        android:layout_width="60dp"
        android:layout_height="1.5dp"
        android:background="#50FFD700"
        app:layout_constraintTop_toBottomOf="@id/tv_bismillah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Zikir Bilgisi Kartı -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_zikir_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1A2E22"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="#40FFD700"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/line_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Kategori Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A4030"
                app:strokeColor="#50FFD700"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tv_zikir_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tesbih"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Arapça Metin -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#0D1A15"
                app:strokeColor="#30FFD700"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tv_zikir_arabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:padding="20dp"
                    android:textDirection="rtl"
                    android:fontFamily="@font/arabic_font"
                    android:lineSpacingMultiplier="1.9"
                    android:shadowColor="#FFD700"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="4" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Okunuş -->
            <TextView
                android:id="@+id/tv_zikir_translit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <!-- Türkçe Anlam -->
            <TextView
                android:id="@+id/tv_zikir_turkish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#AAFFFFFF"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Ana Sayaç Alanı -->
    <FrameLayout
        android:id="@+id/fl_counter"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_zikir_info"
        app:layout_constraintBottom_toTopOf="@id/fl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- Dekoratif Ringler -->
        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- İlerleme Ring -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            app:trackThickness="12dp"
            app:indicatorColor="#FFD700"
            app:trackColor="#15FFFFFF"
            app:trackCornerRadius="6dp" />

        <!-- Merkez İçerik -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="88sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-thin"
                android:text="0"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_target_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#55FFFFFF"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:text="%0"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Sayaç Butonu -->
    <FrameLayout
        android:id="@+id/fl_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/ll_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Glow Efekti -->
        <View
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.2"
            android:translationY="8dp" />

        <View
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.15" />

        <!-- Ana Buton -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_count"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center"
            android:text="+"
            android:textSize="68sp"
            android:textColor="#0D2010"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            app:cornerRadius="84dp"
            android:elevation="16dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:paddingBottom="10dp" />

    </FrameLayout>

    <!-- Kontroller -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="28dp"
        android:paddingTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sıfırla"
            android:textColor="#EE6B6B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="32dp"
            app:strokeColor="#55EE6B6B"
            app:strokeWidth="2dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="22dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/btn_vibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:checked="true"
            android:textColor="#66FFFFFF"
            android:textSize="13sp"
            app:thumbTint="#FFD700"
            app:trackTint="#40FFD700" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>