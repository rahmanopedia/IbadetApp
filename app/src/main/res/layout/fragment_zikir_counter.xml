<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tesbih_gradient">

    <!-- ─── ZİKİR BİLGİ KARTI (glassmorphism) ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_zikir_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#0E1A13"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="#35FFD700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingVertical="14dp">

            <!-- Sol: Transliteration + Türkçe anlam -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:id="@+id/tv_zikir_translit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#F5F5F5"
                        android:letterSpacing="0.01"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_zikir_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="#FFD700"
                        android:background="@drawable/bg_category_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_zikir_turkish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#65FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Dikey ayraç -->
            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="14dp"
                android:background="#20FFD700" />

            <!-- Sağ: Arapça metin -->
            <TextView
                android:id="@+id/tv_zikir_arabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="#FFD700"
                android:gravity="center"
                android:textDirection="rtl"
                android:fontFamily="@font/arabic_font"
                android:lineSpacingMultiplier="1.5"
                android:shadowColor="#90FFD700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ─── SAYAÇ HALKA ALANI (260dp) ─── -->
    <FrameLayout
        android:id="@+id/fl_counter"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toBottomOf="@id/card_zikir_info"
        app:layout_constraintBottom_toTopOf="@id/fl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45">

        <!-- En dış ince dekoratif halka -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- İlerleme göstergesi -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="238dp"
            android:layout_height="238dp"
            android:layout_gravity="center"
            app:trackThickness="12dp"
            app:indicatorColor="#FFD700"
            app:trackColor="#0FFFFFFF"
            app:trackCornerRadius="6dp" />

        <!-- İç koyu cam dairesi (derinlik) -->
        <View
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_counter_circle" />

        <!-- Sayı + bilgi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="78sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-thin"
                android:text="0"
                android:includeFontPadding="false" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:background="#22FFD700" />

            <TextView
                android:id="@+id/tv_target_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#50FFFFFF"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#B8920A"
                android:text="%0"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- ─── ALTIN SAYAÇ BUTONU ─── -->
    <FrameLayout
        android:id="@+id/fl_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/fl_counter"
        app:layout_constraintBottom_toTopOf="@id/ll_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Geniş dış parlama -->
        <View
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.08" />

        <!-- Orta parlama -->
        <View
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_glow"
            android:alpha="0.11" />

        <!-- İnce dış altın çember -->
        <View
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- Ana buton -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_count"
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:text="+"
            android:textSize="60sp"
            android:textColor="#0A1A0E"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            app:cornerRadius="76dp"
            android:elevation="18dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:paddingBottom="8dp" />

    </FrameLayout>

    <!-- ─── ALT KONTROLLER ─── -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingBottom="28dp"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↺  Sıfırla"
            android:textColor="#E06060"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="36dp"
            app:strokeColor="#60E06060"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            android:paddingHorizontal="22dp"
            android:paddingVertical="12dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/btn_vibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:checked="true"
            android:textColor="#55FFFFFF"
            android:textSize="13sp"
            app:thumbTint="#FFD700"
            app:trackTint="#40FFD700" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
