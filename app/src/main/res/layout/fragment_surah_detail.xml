<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1B2A">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Audio Player -->
        <include
            android:id="@+id/audio_player_view"
            layout="@layout/view_audio_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <!-- Besmele -->
    <TextView
        android:id="@+id/tv_bismillah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
        android:textSize="26sp"
        android:textColor="#FFD700"
        android:gravity="center"
        android:fontFamily="@font/arabic_font"
        android:padding="16dp"
        android:background="#14233A"
        android:lineSpacingMultiplier="1.6" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20FFD700" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ayahs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

    </LinearLayout>

</layout>
