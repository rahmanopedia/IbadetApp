{
  "number": 55,
  "name": "الرحمن",
  "englishName": "Ar-Rahman",
  "turkishName": "Rahman",
  "numberOfAyahs": 78,
  "revelationType": "Medinan",
  "ayahs": [
    {
      "number": 54001,
      "numberInSurah": 1,
      "text": "ٱلرَّحۡمَٰنُ",
      "turkishText": "Rahmân'a hamd u sena!"
    },
    {
      "number": 54003,
      "numberInSurah": 2,
      "text": "عَلَّمَ ٱلۡقُرۡءَانَ",
      "turkishText": "Kur'an'ı öğretti."
    },
    {
      "number": 54005,
      "numberInSurah": 3,
      "text": "خَلَقَ ٱلۡإِنسَٰنَ",
      "turkishText": ""
    },
    {
      "number": 54007,
      "numberInSurah": 4,
      "text": "عَلَّمَهُ ٱلۡبَيَانَ",
      "turkishText": ""
    },
    {
      "number": 54009,
      "numberInSurah": 5,
      "text": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ",
      "turkishText": ""
    },
    {
      "number": 54011,
      "numberInSurah": 6,
      "text": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ",
      "turkishText": ""
    },
    {
      "number": 54013,
      "numberInSurah": 7,
      "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ",
      "turkishText": ""
    },
    {
      "number": 54015,
      "numberInSurah": 8,
      "text": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ",
      "turkishText": ""
    },
    {
      "number": 54017,
      "numberInSurah": 9,
      "text": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ",
      "turkishText": ""
    },
    {
      "number": 54019,
      "numberInSurah": 10,
      "text": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ",
      "turkishText": ""
    },
    {
      "number": 54021,
      "numberInSurah": 11,
      "text": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ",
      "turkishText": ""
    },
    {
      "number": 54023,
      "numberInSurah": 12,
      "text": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ",
      "turkishText": ""
    },
    {
      "number": 54025,
      "numberInSurah": 13,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54027,
      "numberInSurah": 14,
      "text": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ",
      "turkishText": ""
    },
    {
      "number": 54029,
      "numberInSurah": 15,
      "text": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ",
      "turkishText": ""
    },
    {
      "number": 54031,
      "numberInSurah": 16,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54033,
      "numberInSurah": 17,
      "text": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ",
      "turkishText": ""
    },
    {
      "number": 54035,
      "numberInSurah": 18,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54037,
      "numberInSurah": 19,
      "text": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ",
      "turkishText": ""
    },
    {
      "number": 54039,
      "numberInSurah": 20,
      "text": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ",
      "turkishText": ""
    },
    {
      "number": 54041,
      "numberInSurah": 21,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54043,
      "numberInSurah": 22,
      "text": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ",
      "turkishText": ""
    },
    {
      "number": 54045,
      "numberInSurah": 23,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54047,
      "numberInSurah": 24,
      "text": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ",
      "turkishText": ""
    },
    {
      "number": 54049,
      "numberInSurah": 25,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54051,
      "numberInSurah": 26,
      "text": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ",
      "turkishText": ""
    },
    {
      "number": 54053,
      "numberInSurah": 27,
      "text": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ",
      "turkishText": ""
    },
    {
      "number": 54055,
      "numberInSurah": 28,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54057,
      "numberInSurah": 29,
      "text": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ",
      "turkishText": ""
    },
    {
      "number": 54059,
      "numberInSurah": 30,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54061,
      "numberInSurah": 31,
      "text": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ",
      "turkishText": ""
    },
    {
      "number": 54063,
      "numberInSurah": 32,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54065,
      "numberInSurah": 33,
      "text": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ",
      "turkishText": ""
    },
    {
      "number": 54067,
      "numberInSurah": 34,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54069,
      "numberInSurah": 35,
      "text": "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ",
      "turkishText": ""
    },
    {
      "number": 54071,
      "numberInSurah": 36,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54073,
      "numberInSurah": 37,
      "text": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ",
      "turkishText": ""
    },
    {
      "number": 54075,
      "numberInSurah": 38,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54077,
      "numberInSurah": 39,
      "text": "فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ",
      "turkishText": ""
    },
    {
      "number": 54079,
      "numberInSurah": 40,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54081,
      "numberInSurah": 41,
      "text": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ",
      "turkishText": ""
    },
    {
      "number": 54083,
      "numberInSurah": 42,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54085,
      "numberInSurah": 43,
      "text": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ",
      "turkishText": ""
    },
    {
      "number": 54087,
      "numberInSurah": 44,
      "text": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ",
      "turkishText": ""
    },
    {
      "number": 54089,
      "numberInSurah": 45,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54091,
      "numberInSurah": 46,
      "text": "وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ",
      "turkishText": ""
    },
    {
      "number": 54093,
      "numberInSurah": 47,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54095,
      "numberInSurah": 48,
      "text": "ذَوَاتَآ أَفۡنَانٖ",
      "turkishText": ""
    },
    {
      "number": 54097,
      "numberInSurah": 49,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54099,
      "numberInSurah": 50,
      "text": "فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ",
      "turkishText": ""
    },
    {
      "number": 54101,
      "numberInSurah": 51,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54103,
      "numberInSurah": 52,
      "text": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ",
      "turkishText": ""
    },
    {
      "number": 54105,
      "numberInSurah": 53,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54107,
      "numberInSurah": 54,
      "text": "مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى ٱلۡجَنَّتَيۡنِ دَانٖ",
      "turkishText": ""
    },
    {
      "number": 54109,
      "numberInSurah": 55,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54111,
      "numberInSurah": 56,
      "text": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ",
      "turkishText": ""
    },
    {
      "number": 54113,
      "numberInSurah": 57,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54115,
      "numberInSurah": 58,
      "text": "كَأَنَّهُنَّ ٱلۡيَاقُوتُ وَٱلۡمَرۡجَانُ",
      "turkishText": ""
    },
    {
      "number": 54117,
      "numberInSurah": 59,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "turkishText": ""
    },
    {
      "number": 54119,
      "numberInSurah": 60,
      "text": "هَلۡ جَزَآءُ ٱلۡإِحۡسَٰنِ إِلَّا ٱلۡإِحۡسَٰنُ",
