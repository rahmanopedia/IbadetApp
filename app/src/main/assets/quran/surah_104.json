{
  "number": 104,
  "name": "الهمزة",
  "englishName": "Al-Humazah",
  "turkishName": "Hümeze",
  "numberOfAyahs": 9,
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 1,
      "numberInSurah": 1,
      "text": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "turkishText": "Her (arkadan) çekiştiren ve kaş göz hareketleriyle alay edip duran kimsenin vay hâline!"
    },
    {
      "number": 2,
      "numberInSurah": 2,
      "text": "الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ",
      "turkishText": "O ki mal topladı ve onu saydı durdu."
    },
    {
      "number": 3,
      "numberInSurah": 3,
      "text": "يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ",
      "turkishText": "Malının onu ebedî kılacağını sanıyor."
    },
    {
      "number": 4,
      "numberInSurah": 4,
      "text": "كَلَّا ۖ لَيُنبَذَنَّ فِي الْحُطَمَةِ",
      "turkishText": "Hayır! Andolsun o Hutame'ye (parçalayıcı ateşe) atılacak."
    },
    {
      "number": 5,
      "numberInSurah": 5,
      "text": "وَمَا أَدْرَاكَ مَا الْحُطَمَةُ",
      "turkishText": "Hutame'nin ne olduğunu sana ne bildirdi?"
    },
    {
      "number": 6,
      "numberInSurah": 6,
      "text": "نَارُ اللَّهِ الْمُوقَدَةُ",
      "turkishText": "O, Allah'ın tutuşturulmuş ateşidir."
    },
    {
      "number": 7,
      "numberInSurah": 7,
      "text": "الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ",
      "turkishText": "Ki o, kalplere kadar yükselip işler."
    },
    {
      "number": 8,
      "numberInSurah": 8,
      "text": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "turkishText": "Şüphesiz o (ateş) onların üzerine kapanmıştır."
    },
    {
      "number": 9,
      "numberInSurah": 9,
      "text": "فِي عَمَدٍ مُّمَدَّدَةٍ",
      "turkishText": "Uzatılmış sütunlar içinde."
    }
  ]
}