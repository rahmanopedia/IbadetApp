{
  "number": 75,
  "name": "القيامة",
  "englishName": "Al-Qiyamah",
  "turkishName": "Kıyame",
  "numberOfAyahs": 40,
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 74001,
      "numberInSurah": 1,
      "text": "لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ",
      "turkishText": "Hayır (cehennem), ben andolsun, oluş, biliş ve niyetin sırlarına; ben insan, kendi amelinin pişmanındır."
    },
    {
      "number": 74003,
      "numberInSurah": 2,
      "text": "وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ",
      "turkishText": "O gün kaçmaya vakit almamıştır, kınalı vakit kaçmağı temennisi fayda vermez."
    },
    {
      "number": 74005,
      "numberInSurah": 3,
      "text": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74007,
      "numberInSurah": 4,
      "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74009,
      "numberInSurah": 5,
      "text": "بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74011,
      "numberInSurah": 6,
      "text": "يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ",
      "turkishText": ""
    },
    {
      "number": 74013,
      "numberInSurah": 7,
      "text": "فَإِذَا بَرِقَ ٱلۡبَصَرُ",
      "turkishText": ""
    },
    {
      "number": 74015,
      "numberInSurah": 8,
      "text": "وَخَسَفَ ٱلۡقَمَرُ",
      "turkishText": ""
    },
    {
      "number": 74017,
      "numberInSurah": 9,
      "text": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ",
      "turkishText": ""
    },
    {
      "number": 74019,
      "numberInSurah": 10,
      "text": "يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ",
      "turkishText": ""
    },
    {
      "number": 74021,
      "numberInSurah": 11,
      "text": "كَلَّا لَا وَزَرَ",
      "turkishText": ""
    },
    {
      "number": 74023,
      "numberInSurah": 12,
      "text": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ",
      "turkishText": ""
    },
    {
      "number": 74025,
      "numberInSurah": 13,
      "text": "يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "turkishText": ""
    },
    {
      "number": 74027,
      "numberInSurah": 14,
      "text": "بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ",
      "turkishText": ""
    },
    {
      "number": 74029,
      "numberInSurah": 15,
      "text": "وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74031,
      "numberInSurah": 16,
      "text": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ",
      "turkishText": ""
    },
    {
      "number": 74033,
      "numberInSurah": 17,
      "text": "إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74035,
      "numberInSurah": 18,
      "text": "فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74037,
      "numberInSurah": 19,
      "text": "ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ",
      "turkishText": ""
    },
    {
      "number": 74039,
      "numberInSurah": 20,
      "text": "كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ",
      "turkishText": ""
    },
    {
      "number": 74041,
      "numberInSurah": 21,
      "text": "وَتَذَرُونَ ٱلۡأٓخِرَةَ",
      "turkishText": ""
    },
    {
      "number": 74043,
      "numberInSurah": 22,
      "text": "وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ",
      "turkishText": ""
    },
    {
      "number": 74045,
      "numberInSurah": 23,
      "text": "إِلَىٰ رَبِّهَا نَاظِرَةٞ",
      "turkishText": ""
    },
    {
      "number": 74047,
      "numberInSurah": 24,
      "text": "وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ",
      "turkishText": ""
    },
    {
      "number": 74049,
      "numberInSurah": 25,
      "text": "تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ",
      "turkishText": ""
    },
    {
      "number": 74051,
      "numberInSurah": 26,
      "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ",
      "turkishText": ""
    },
    {
      "number": 74053,
      "numberInSurah": 27,
      "text": "وَقِيلَ مَنۡۜ رَاقٖ",
      "turkishText": ""
    },
    {
      "number": 74055,
      "numberInSurah": 28,
      "text": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ",
      "turkishText": ""
    },
    {
      "number": 74057,
      "numberInSurah": 29,
      "text": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "turkishText": ""
    },
    {
      "number": 74059,
      "numberInSurah": 30,
      "text": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ",
      "turkishText": ""
    },
    {
      "number": 74061,
      "numberInSurah": 31,
      "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "turkishText": ""
    },
    {
      "number": 74063,
      "numberInSurah": 32,
      "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "turkishText": ""
    },
    {
      "number": 74065,
      "numberInSurah": 33,
      "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ",
      "turkishText": ""
    },
    {
      "number": 74067,
      "numberInSurah": 34,
      "text": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ",
      "turkishText": ""
    },
    {
      "number": 74069,
      "numberInSurah": 35,
      "text": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ",
      "turkishText": ""
    },
    {
      "number": 74071,
      "numberInSurah": 36,
      "text": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى",
      "turkishText": ""
    },
    {
      "number": 74073,
      "numberInSurah": 37,
      "text": "أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ",
      "turkishText": ""
    },
    {
      "number": 74075,
      "numberInSurah": 38,
      "text": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ",
      "turkishText": ""
    },
    {
      "number": 74077,
      "numberInSurah": 39,
      "text": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
      "turkishText": ""
    },
    {
      "number": 74079,
      "numberInSurah": 40,
      "text": "أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ",
      "turkishText": ""
    }
  ]
}